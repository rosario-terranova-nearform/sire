# OpenRouter key. The browser calls OpenRouter directly with this (§7), so it
# lives in .env.local and is read at build/dev time. No in-app key entry.
# Leave it blank to run the app in demo mode — a canned transcript with a
# visible "the court is a recording today" banner.
VITE_OPENROUTER_API_KEY=

# Opt in to the live-model tests (npm run test:live). Unset, every
# network-touching test is skipped and `npm run test` stays offline.
VITE_SIRE_LIVE_AI_TESTS=
